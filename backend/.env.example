# ==============================================
# 对话模型（OpenAI 兼容协议，必填）
# 任意兼容服务：OpenAI / DeepSeek / 百炼 compatible-mode / 智谱 / Moonshot / vLLM / Ollama /v1
# ==============================================
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_api_key
OPENAI_MODEL_NAME=qwen3-max

# ==============================================
# 检索规划小模型（可选；不配则自动复用 EMBED_* ，
# 再回落 OPENAI_*；只需改模型名即可；Qwen 系通道自动关 thinking）
# deepseek-ai/DeepSeek-V3-0324（强但易限流）
# ==============================================
# PLANNER_BASE_URL=https://api.siliconflow.cn/v1
# PLANNER_API_KEY=sk-xxx
PLANNER_MODEL_NAME=Qwen/Qwen3-8B
# 规划超时秒数（超时回确定性 fallback，保证延迟有上界）
PLANNER_TIMEOUT_S=12

# ==============================================
# 视觉模型（可选能力；默认关闭。VISION_* 留空则整体回落 OPENAI_*）
# ==============================================
VISION_ENABLED=false
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL_NAME=qwen-vl-max

# ==============================================
# 嵌入模型（可选能力；EMBED_* 留空则整体回落 OPENAI_*）
# ==============================================
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL_NAME=text-embedding-v3

# ==============================================
# 跨平台混搭示例：三个模型可以来自三个不同平台（各自独立三件套）
#   对话=DeepSeek： OPENAI_BASE_URL=https://api.deepseek.com/v1 / OPENAI_API_KEY=sk-ds / OPENAI_MODEL_NAME=deepseek-chat
#   视觉=百炼：     VISION_ENABLED=true / VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                   VISION_API_KEY=sk-ali / VISION_MODEL_NAME=qwen-vl-max
#   嵌入=Ollama：   EMBED_BASE_URL=http://localhost:11434/v1 / EMBED_API_KEY=ollama / EMBED_MODEL_NAME=qwen3-embedding:0.6b
# 注意：不要只配 VISION_BASE_URL 或 EMBED_BASE_URL 而漏配对应 API_KEY——
#       部分配置不会被回落补全，避免跨供应商混用凭据（视觉会降级关闭，嵌入会报错）。
# ==============================================

# ==============================================
# 视觉模型批处理优化配置（降低API调用次数和延迟）
# ==============================================
VISION_BATCH_SIZE=5
VISION_DEDUP_ENABLED=true
VISION_DEDUP_THRESHOLD=10
VISION_BATCH_LOW_RES=true

# ==============================================
# 云端重排序配置（SiliconFlow / Jina / Cohere 兼容 rerank API）
# 未配置时重排序调用失败，按原顺序 + similarity 0 降级
# compatible：SiliconFlow / Jina / Cohere；dashscope：阿里云百炼原生接口
RERANKER_PROVIDER=compatible
RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=sk-xxx
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
# 重排序总等待上限（秒）；召回候选数（每个文本检索步骤）
RERANKER_TIMEOUT_SECONDS=8
RERANKER_CANDIDATE_K=20
# 重排后默认取 3 条本地证据（2026-10-23 Top-K 小样本对照）；可设 1～8。
# 独立保留 6000 字符预算与最终融合最多 8 条的上限，网页可按既有规则补充。
RAG_CONTEXT_K=3

# 可答性原文核对总超时；缺少依据或核对失败时暂停资料作答
ANSWERABILITY_TIMEOUT_SECONDS=8
# 资料答案生成后逐块核对原文，核对完成前不显示草稿；失败时明确暂停。
ANSWER_VERIFICATION_ENABLED=true
ANSWER_VERIFICATION_TIMEOUT_SECONDS=12
# 多轮追问指代补全的等待上限；复用规划模型，不需要另外配置 API。
QUERY_REWRITE_TIMEOUT_SECONDS=4
# 整个补充图谱检索的等待预算；超时取消该分支，继续核对文本证据。
GRAPH_RETRIEVAL_TIMEOUT_SECONDS=4
# Agent 执行阶段总预算（含模型/工具，不含前置 RAG）；超时终止并返回错误帧。
AGENT_RUN_TIMEOUT_SECONDS=60
# 百炼配置示例（替换以上同名项；WorkspaceId 与 API Key 需属于同一地域/业务空间）：
# RERANKER_PROVIDER=dashscope
# RERANKER_API_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1
# RERANKER_API_KEY=你的百炼API密钥
# RERANKER_MODEL=qwen3-rerank

# 向量召回范围：本用户/来源类型范围内不超过此数量时精确排序；0 关闭精确路径。
VECTOR_EXACT_SCOPE_LIMIT=2000
# 大范围 ANN 候选逐次扩大到此上限；不是每次都召回这么多。
VECTOR_ANN_MAX_CANDIDATES=2048

# ==============================================
# 数据库配置
# 注意：使用 Docker 一键启动（docker compose）时，MYSQL_*/REDIS_*/NEO4J_* 的
# 地址与密码由 docker-compose.yml 自动覆盖为容器内部值，本文件只需配置 LLM 相关 Key。
# 本地开发（非 Docker）时才需要按本机实际服务修改下面这些配置。
# ==============================================
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==============================================
# 限流配置
# ==============================================
RATE_LIMIT_ENABLED=false

# ==============================================
# Agentic RAG web search fallback (disabled by default)
# Providers: tavily or serper
# ==============================================
WEB_SEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_API_KEY=

# ==============================================
# JWT 身份验证配置
# ==============================================
SECRET_KEY=MY_JWT_SECRET_KWY_FOR_USR_AND_I_JUST_WRITE_THIS
ALGORITHM=HS256

# ==============================================
# Neo4j 知识图谱数据库（本地默认安装即可用，服务名 neo4j）
# ==============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
